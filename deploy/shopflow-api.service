[Unit]
Description=ShopFlow API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopflow
WorkingDirectory=/srv/shopflow
EnvironmentFile=/srv/shopflow/.env
ExecStart=/usr/bin/npm run start -w @shopflow/api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
