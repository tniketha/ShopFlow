{
  "name": "@shopflow/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "tniketha",
  "scripts": {
    "dev": "node --watch --env-file=../.env src/server.js",
    "start": "node --env-file=../.env src/server.js",
    "test": "vitest run test/unit.test.js",
    "test:integration": "vitest run test/integration.test.js --maxWorkers=1",
    "db:migrate": "node --env-file=../.env src/migrate.js",
    "owner:create": "node --env-file=../.env src/create-owner.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "vitest": "^4.0.18",
    "supertest": "^7.1.4"
  }
}
